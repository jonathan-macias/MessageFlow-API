<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MessageFlow.Domain\MessageFlow.Domain.csproj" />
  </ItemGroup>

  <!-- Permite a los tests cubrir lógica interna con aritmética propia (por ejemplo el
       cálculo de candidatos vectoriales y el parseo de operadores), que si quedara
       privada se verificaría solo de forma indirecta a través del handler. -->
  <ItemGroup>
    <InternalsVisibleTo Include="MessageFlow.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
