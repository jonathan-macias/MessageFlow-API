# Copiar a /opt/messageflow/.env en la Orange Pi y rellenar.
#   chmod 600 /opt/messageflow/.env
# Este archivo NO se sube a Git (.gitignore ya ignora .env).
#
# Genera valores aleatorios con:  openssl rand -hex 32
# Usa solo letras y números en POSTGRES_PASSWORD (va dentro de cadenas de conexión).

# ── Gestionado por deploy.sh: déjalo vacío, el primer deploy lo rellena ──────
IMAGE_TAG=
# IMAGE_NAMESPACE=ghcr.io/jonathan-macias

# ── Base de datos ─────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=

# ── Evolution API (WhatsApp) ──────────────────────────────────────────────────
# Misma clave para el servidor Evolution y para MessageFlow (EvolutionApi__GlobalApiKey).
EVOLUTION_API_KEY=
EvolutionApi__Instance=
# EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.7
# EVOLUTION_SERVER_URL=http://localhost:8081
# EVOLUTION_BIND=127.0.0.1

# ── MessageFlow (variables de entorno = claves de appsettings con "__") ───────
Jwt__Secret=
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Gemini__ApiKey=
Ops__ApiKey=

# Orígenes permitidos por CORS (tu frontend en producción).
Cors__AllowedOrigins__0=https://app.tudominio.com
