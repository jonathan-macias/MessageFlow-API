<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MiniExcel" Version="1.46.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.*" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MessageFlow.Domain\MessageFlow.Domain.csproj" />
    <ProjectReference Include="..\MessageFlow.Application\MessageFlow.Application.csproj" />
    <ProjectReference Include="..\MessageFlow.Infrastructure\MessageFlow.Infrastructure.csproj" />
    <ProjectReference Include="..\MessageFlow.Api\MessageFlow.Api.csproj" />
  </ItemGroup>

  <!-- El appsettings real se copia a la salida de los tests para poder verificar que la
       configuración que se despliega sigue enlazando con las clases de opciones. Un test
       que usa un appsettings de mentira no detectaría una clave renombrada. -->
  <ItemGroup>
    <None Include="..\MessageFlow.Api\appsettings.json" Link="api-appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\MessageFlow.Api\appsettings.example.json" Link="api-appsettings.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>