{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=messageflow;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD"
  },
  "EvolutionApi": {
    "BaseUrl": "http://localhost:8080",
    "Instance": "YOUR_EVOLUTION_INSTANCE",
    "GlobalApiKey": "YOUR_EVOLUTION_GLOBAL_API_KEY",
    "TimeoutSeconds": 30
  },
  "Scheduling": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "ConsumerBatchSize": 20,
    "MaxCatchUpOccurrences": 5
  },
  "Jwt": {
    "Issuer": "MessageFlow",
    "Audience": "MessageFlow",
    "Secret": "REPLACE_WITH_A_STRONG_SECRET_AT_LEAST_32_CHARS",
    "ExpirationMinutes": 60
  },
  "Authentication": {
    "Google": {
      "ClientId": "YOUR_CLIENT_ID",
      "ClientSecret": "YOUR_CLIENT_SECRET"
    }
  },
  "Gemini": {
    "ApiKey": "YOUR_GEMINI_API_KEY",
    "Model": "gemini-3.5-flash-lite"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
